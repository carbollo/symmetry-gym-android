# Puerto (Railway lo inyecta automaticamente; en local por defecto 3000).
PORT=3000

# Clave privada con la que se firman los entitlements de premium. Generala con `node gen-keys.js`
# (1a salida). Sin ella se usa una clave EFIMERA (solo dev).
# ENTITLEMENT_PRIVATE_KEY=...

# ID de TU unidad de anuncio recompensada, tal como llega en el parametro `ad_unit` del callback SSV
# (lo veras en los logs en el primer callback real; suele ser la parte NUMERICA de tu ID de unidad).
# Blinda /admob/ssv para que solo cuenten TUS anuncios. Sin definir, el servidor avisa y no filtra.
# ADMOB_AD_UNIT=1234567890

# Postgres. En Railway: anade el plugin Postgres y esta variable se inyecta sola.
# Dejala vacia para usar el almacen en memoria (solo desarrollo).
# DATABASE_URL=postgres://user:pass@host:5432/db

# Pon "require" solo si tu DATABASE_URL es una conexion EXTERNA que exige SSL.
# Para la conexion interna de Railway, dejala sin definir.
# PGSSL=require
