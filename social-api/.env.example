# Puerto (Railway lo inyecta solo; en local por defecto 3001 para no chocar con el server de ads).
PORT=3001

# Postgres. En Railway: comparte el mismo plugin Postgres que el server de ads
# (Variables -> Reference -> Postgres.DATABASE_URL).
DATABASE_URL=postgres://user:pass@localhost:5432/zenit

# Secreto para firmar los JWT. GENERA UNO LARGO Y ALEATORIO (>=32 chars). Nunca lo subas al repo.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Validez del token en segundos (por defecto 30 dias). El móvil no refresca; guarda uno solo.
JWT_EXPIRES_IN=2592000

NODE_ENV=development
